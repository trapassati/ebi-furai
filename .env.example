# Ebi Furai settings. Copy to .env (Docker) or /etc/ebi-furai/ebi-furai.env
# (native install) and change what you need: every line is optional.

# ---- Network ----
# Docker: where the port is published. 0.0.0.0 = your whole network;
# 127.0.0.1 = only this machine (with a tunnel or reverse proxy here).
# BIND_ADDR=0.0.0.0
# PORT=9099
# Native install: the address the server listens on.
# LISTEN_ADDR=:9099

# Secure cookies: auto (when the app is opened over https), true or false.
# COOKIE_SECURE=auto

# Behind Cloudflare Tunnel: trust CF-Connecting-IP for the sign-in rate
# limit. Only when nothing else can reach the port.
# TRUST_CF_HEADER=false

# ---- First administrator ----
# Without these, the app asks to create the administrator at first start
# with a setup code printed in the server log (docker compose logs).
# Used only when the database has no users.
# ADMIN_USER=admin
# ADMIN_PASSWORD=

# ---- App ----
# Name shown in the app and under the Home Screen icon.
# APP_NAME=Ebi Furai

# Time zone: the "Today" collection and the notification times.
# TZ=Europe/Rome

# How often feeds are refreshed (at least 5m; each user can choose too),
# how many at once, and how many days articles are kept (starred ones stay).
# REFRESH_INTERVAL=20m
# FETCH_WORKERS=4
# RETENTION_DAYS=90

# Article images go through the server: sites don't see your devices, and
# http images work in the https app.
# IMAGE_PROXY=true

# Ad filter lists (default: EasyList and EasyList Italia).
# AD_FILTER_LISTS=https://easylist.to/easylist/easylist.txt,https://easylist-downloads.adblockplus.org/easylistitaly.txt

# Contact sent to the push services with each notification. Default: the
# https address the app is opened from.
# VAPID_SUBJECT=mailto:you@example.com

# ---- Data ----
# Where the database lives (the Docker image uses /data).
# DATA_DIR=/data

# Daily backups of the database, kept for 7 days and 4 weeks.
# BACKUPS=true
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_DIR=/data/backups

# ---- Updates ----
# Look for a new release on GitHub twice a day and tell the administrators in
# the app. false: the server never contacts GitHub.
# UPDATE_CHECK=true

# ---- Source code ----
# The AGPL-3.0 asks to offer the source to everyone who uses the app. If you
# run a modified version, point this to your own copy.
# SOURCE_URL=https://github.com/trapassati/ebi-furai
